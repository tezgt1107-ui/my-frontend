@{ ViewData["Title"] = "JSON／YAML／XML／CSV 互轉"; }
<div class="tool-page data-converter">
    <header class="page-heading">
        <div>
            <span class="eyebrow">DATA</span>
            <h1>JSON／YAML／XML／CSV 互轉</h1>
            <p>上傳或貼上資料，選擇輸出格式後在瀏覽器本機完成轉換。</p>
        </div>
    </header>

    <section class="upload-card" id="converterDropZone">
        <input id="converterFile" type="file" accept=".json,.yaml,.yml,.xml,.csv,text/plain,application/json,application/xml,text/csv" />
        <div>
            <strong>選擇或拖曳資料檔案</strong>
            <span>支援 .json、.yaml、.yml、.xml、.csv</span>
        </div>
    </section>

    <div class="converter-controls">
        <label>輸入格式
            <select id="converterInputFormat">
                <option value="auto">自動判斷</option>
                <option value="json">JSON</option>
                <option value="yaml">YAML</option>
                <option value="xml">XML</option>
                <option value="csv">CSV</option>
            </select>
        </label>
        <button type="button" id="converterSwap" aria-label="交換輸入與輸出格式">⇄</button>
        <label>輸出格式
            <select id="converterOutputFormat">
                <option value="json">JSON</option>
                <option value="yaml">YAML</option>
                <option value="xml">XML</option>
                <option value="csv">CSV</option>
            </select>
        </label>
        <label>XML 根節點
            <input id="converterRootName" value="root" />
        </label>
    </div>

    <div class="toolbar">
        <button type="button" id="converterRun">開始轉換</button>
        <button type="button" id="converterExample">載入範例</button>
        <button type="button" data-copy-target="#converterOutput">複製結果</button>
        <button type="button" id="converterDownload">下載結果</button>
        <button type="button" class="ghost" id="converterClear">清除</button>
    </div>

    <div class="editor-grid">
        <label class="editor-panel"><span id="converterInputLabel">輸入資料</span><textarea id="converterInput" spellcheck="false"></textarea></label>
        <label class="editor-panel"><span id="converterOutputLabel">JSON 輸出</span><textarea id="converterOutput" spellcheck="false" readonly></textarea></label>
    </div>
    <div class="status-line" id="converterStatus" role="status">等待資料</div>
</div>
@section Scripts { <script src="~/js/tools-data-converter.js" asp-append-version="true"></script> }
