@{ ViewData["Title"] = "文字批次處理"; }
<div class="tool-page"><header class="page-heading"><div><span class="eyebrow">TEXT</span><h1>文字批次處理</h1><p>一次完成清理、去重、排序及格式加工。</p></div></header>
<div class="option-bar"><label>前綴<input id="textPrefix" placeholder="例如：'" /></label><label>後綴<input id="textSuffix" placeholder="例如：'," /></label><label><input id="textTrim" type="checkbox" checked /> 去除首尾空白</label><label><input id="textRemoveEmpty" type="checkbox" checked /> 移除空行</label><label><input id="textDistinct" type="checkbox" /> 去重</label><label>轉換<select id="textCase"><option value="none">不轉換</option><option value="upper">大寫</option><option value="lower">小寫</option><option value="camel">camelCase</option><option value="pascal">PascalCase</option><option value="snake">snake_case</option><option value="kebab">kebab-case</option></select></label></div>
<div class="toolbar"><button id="textProcess">執行處理</button><button id="textSort">排序</button><button id="textReverse">反轉順序</button><button data-copy-target="#textOutput">複製結果</button></div>
<div class="editor-grid"><label class="editor-panel"><span>原始文字</span><textarea id="textInput"></textarea></label><label class="editor-panel"><span>處理結果</span><textarea id="textOutput" readonly></textarea></label></div><div class="status-line" id="textStatus">等待輸入</div></div>
@section Scripts { <script src="~/js/tools-text.js" asp-append-version="true"></script> }
